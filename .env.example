# Скопируйте в .env и меняйте при необходимости
UI_PORT=8501
API_PORT=8000
MAX_UPLOAD_MB=10
MAX_ACTIVE_JOBS=10
MAX_PDF_PAGES=3
JOB_TTL_MINUTES=60
CLEANUP_EVERY_MINUTES=5
LOG_LEVEL=INFO
# 1 = TrOCR включён (torch+transformers, модель запекается в образ). 0 = только Paddle, образ легче. Нужна пересборка.
WITH_HANDWRITING=1
